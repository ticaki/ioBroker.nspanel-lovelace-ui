{
    "name": "nspanel-lovelace-ui-web",
    "private": true,
    "version": "0.1.0",
    "description": "NSPanel Lovelace UI rendered in a web browser",
    "type": "module",
    "scripts": {
        "start": "vite --port 4174",
        "gen:icons": "tsx scripts/gen-icons.ts",
        "prebuild": "npm run gen:icons",
        "build": "tsc && vite build",
        "lint": "eslint -c eslint.config.mjs",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource/roboto": "^5.3.0",
        "@types/qrcode": "^1.5.6",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@iobroker/eslint-config": "^2.3.4",
        "@mdi/svg": "^7.4.47",
        "@types/node": "^25.9.4",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^8.2.1",
        "vitest": "^5.0.5"
    }
}
