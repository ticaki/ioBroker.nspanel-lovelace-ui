                    "default": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "forceTFTVersion": {
                    "type": "text",
                    "label": "Pinned TFT firmware version. For testing only - no support or inquiries. Use at your own risk.",
                    "default": "",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "hideDeveloperSymbols": {
                    "type": "checkbox",
                    "label": "hideDeveloperSymbols",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 2
                },
                "_header1": {
                    "type": "header",
                    "label": "Danger Zone - only for users who know exactly what they are doing",
                    "size": 3,
                    "text": "Danger Zone",
                    "hidden": "false",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_activateURls": {
                    "type": "checkbox",
                    "label": "activateURLs",
                    "help": "activateURLsHelp",
                    "default": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "versionJsonUrl": {
                    "type": "text",
                    "label": "Override URL for the version JSON file.",
                    "tooltip": "https://raw.githubusercontent.com/ticaki/ioBroker.nspanel-lovelace-ui/main/json/version.json",
                    "default": "https://raw.githubusercontent.com/ticaki/ioBroker.nspanel-lovelace-ui/main/json/version.json",
                    "newLine": true,
                    "disabled": "!data._activateURls",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "berryUrl": {
                    "type": "text",
                    "label": "Override URL for the Berry Script.",
                    "tooltip": "https://raw.githubusercontent.com/ticaki/ioBroker.nspanel-lovelace-ui/main/tasmota/berry",
                    "default": "https://raw.githubusercontent.com/ticaki/ioBroker.nspanel-lovelace-ui/main/tasmota/berry",
                    "disabled": "!data._activateURls",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "tftUrl": {
                    "type": "text",
                    "label": "Override URL for the TFT Server. (http only)",
                    "tooltip": "http://nspanel.de",
                    "default": "http://nspanel.de",
                    "disabled": "!data._activateURls",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_header": {
                    "type": "header",
                    "label": "Not used",
                    "size": 3,
                    "text": "Not used",
                    "hidden": "false",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "myCustomAttribute": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
