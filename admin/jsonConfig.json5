                }
            }
        },
        "tasmotaTools": {
            "type": "panel",
            "label": "tasmotaTools",
            "expertMode": true,
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "_openLinkWikiTasmotaTools": {
                    "type": "staticLink",
                    "text": "openLinkWikiTasmotaTools",
                    // documentation in the ioBroker system language: German -> de, everything else -> en
                    "href": "https://ticaki.github.io/ioBroker.nspanel-lovelace-ui/${_system.language === 'de' ? 'de' : 'en'}/tasmotatools.html",
                    "icon": "info",
                    "button": true,
                    "style": {
                        "fontSize": 16,
                        "color": "red"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_header2": {
                    "type": "header",
                    "label": "tasmotaDeviceTools",
                    "text": "tasmotaDeviceTools",
                    "size": 3,
                    "newLine": true
                },
                "_selectIpForTools": {
                    "type": "autocompleteSendTo",
                    "command": "getTasmotaDevices",
                    "jsonData": "{\"ip\": \"${data.internalServerIp}\"}",
                    "label": "ipFromPanel",
                    "freeSolo": true,
                    "newLine": true,
                    "validator": "typeof data._selectIpForTools === 'string' && data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) !== -1",
                    "validatorErrorText": "mustBeIp",
                    "default": "",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_tasmotaRestartSendTo": {
                    "type": "sendTo",
                    "label": "jc_tasmota_restart",
                    "jsonData": "{ \"tasmotaIP\": \"${data._selectIpForTools}\"}",
                    "showProcess": true,
                    "command": "tasmotaRestartSendTo",
                    "disabled": "!data._selectIpForTools || data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) === -1",
                    "variant": "outlined",
                    "confirm": {
                        "title": "tasmotaRestartConfirmTitle",
                        "text": "tasmotaRestartConfirmText",
                        "ok": "jc_tasmota_restart",
                        "cancel": "Cancel"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_openLinkToTasmota": {
                    "type": "sendTo",
                    "label": "openLinkToTasmota",
                    "jsonData": "{\"ip\": \"${data._selectIpForTools}\"}",
                    "openUrl": true,
                    "command": "openLinkToTasmota",
                    "disabled": "!data._selectIpForTools",
                    "variant": "outlined",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_berryInstallSendTo": {
                    "type": "sendTo",
                    "label": "berryInstallSendTo",
                    "jsonData": "{\"tasmotaIP\": \"${data._selectIpForTools}\"}",
                    "showProcess": true,
                    "command": "berryInstallSendTo",
                    "disabled": "!data._selectIpForTools || data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) === -1",
                    "variant": "contained",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_tftInstallSendTo": {
                    "type": "sendTo",
                    "label": "tftInstallSendTo",
                    "jsonData": "{\"tasmotaIP\": \"${data._selectIpForTools}\", \"internalServerIp\": \"${data.internalServerIp}\", \"useBetaTFT\": ${data.useBetaTFT}, \"model\": \"${data.nsPanelModel}\" }",
                    "showProcess": true,
                    "command": "tftInstallSendTo",
                    "disabled": "!data._selectIpForTools || data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) === -1",
                    "variant": "contained",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_header": {
                    "type": "header",
                    "size": 5,
                    "text": "jc_tasmota_expertMode",
                    "expertMode": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_resetTasmota": {
                    "type": "sendTo",
                    "label": "resetTasmota",
                    "jsonData": "{\"tasmotaIP\": \"${data._selectIpForTools}\"}",
                    "openUrl": true,
                    "command": "resetTasmota",
                    "disabled": "!data._selectIpForTools",
                    "variant": "contained",
                    "expertMode": true,
                    "confirm": {
                        "title": "tasmotaResetConfirmTitle",
                        "text": "tasmotaResetConfirmText",
                        "ok": "Reset",
                        "cancel": "Cancel"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_overview": {
            "type": "panel",
            "label": "nsPanelSettings",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword))",
