                    "name": "AdminComponentTemplateSet/Components/IconSelect",
                    "bundlerType": "module",
                    "xs": 12,
                    "sm": 10,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                    //"label": "test"
                },
                "logUnknownTokens": {
                    "type": "checkbox",
                    "label": "logUnknownTokens",
                    "default": false,
                    "hidden": "false",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_channelConfigDialog": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/ChannelConfigDialog",
                    "bundlerType": "module",
                    "newLine": true,
                    "xs": 12
                }
            }
        },
        "NavigationFlow": {
