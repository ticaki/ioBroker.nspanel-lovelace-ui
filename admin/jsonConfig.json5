{
    "i18n": "custom/i18n",
    "type": "tabs",
    "items": {
        "_tabMaintain": {
            "type": "panel",
            "label": "jc_tab_maintain",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "pageGlobalSettings": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/TabMaintain",
                    "bundlerType": "module",
                    "xs": 12
                    //"label": "test"
                }
            }
        },
        "_pageGlobalSettings": {
            "type": "panel",
            "label": "jc_tab_globalSettings",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "pageGlobalSettings": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/PageGlobalSettings",
                    "bundlerType": "module",
                    "xs": 12
                    //"label": "test"
                }
            }
        },
        "colorThemen": {
            "type": "panel",
            "label": "colorTheme",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || data.colorTheme !== 5",
            "items": {
                "_openLinkWikiColorThemes": {
                    "type": "staticLink",
                    "text": "jc_color_wikiLink",
                    // documentation in the ioBroker system language: German -> de, everything else -> en
                    "href": "https://ticaki.github.io/ioBroker.nspanel-lovelace-ui/${_system.language === 'de' ? 'de' : 'en'}/colorTheme.html",
                    "icon": "info",
                    "button": true,
                    "style": {
                        "fontSize": 16,
                        "color": "red"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "colorStates": {
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "type": "accordion",
                    "label": "jc_color_states",
                    "noDelete": true,
                    "items": [
                        {
                            "attr": "colGood",
                            "type": "color",
                            "label": "jc_color_state_good",
                            "default": "#00ff00",
