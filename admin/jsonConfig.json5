{
    "i18n": "custom/i18n",
    "type": "tabs",
    "items": {
        "_tabMaintain": {
            "type": "panel",
            "label": "Maintain",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "pageGlobalSettings": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/TabMaintain",
                    "bundlerType": "module",
                    "xs": 12
                    //"label": "test"
                }
            }
        },
        "_pageGlobalSettings": {
            "type": "panel",
            "label": "Global Settings",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "pageGlobalSettings": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/PageGlobalSettings",
                    "bundlerType": "module",
                    "xs": 12
                    //"label": "test"
                }
            }
        },
        "colorThemen": {
            "type": "panel",
            "label": "colorTheme",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || data.colorTheme !== 5",
            "items": {
                "_openLinkWikiColorThemes": {
                    "type": "staticLink",
                    "text": "openLinkWikiColorThemes",
                    "href": "https://github.com/ticaki/ioBroker.nspanel-lovelace-ui/wiki/ColorThemes",
                    "icon": "info",
                    "button": true,
                    "style": {
                        "fontSize": 16,
                        "color": "red"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "colorStates": {
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
