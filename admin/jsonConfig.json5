                }
            }
        },
        "_screensaver": {
            "type": "panel",
            "label": "Screensaver",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "screensaverConfig": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/ScreensaverConfigManager",
                    "bundlerType": "module",
                    "xs": 12
                }
            }
        },
        "tasmotaTools": {
            "type": "panel",
            "label": "tasmotaTools",
            "expertMode": true,
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword)) || !data.panels || !data.panels.length",
            "items": {
                "_openLinkWikiTasmotaTools": {
                    "type": "staticLink",
                    "text": "openLinkWikiTasmotaTools",
                    "href": "https://github.com/ticaki/ioBroker.nspanel-lovelace-ui/wiki/Tasmota-Tools",
                    "icon": "info",
                    "button": true,
                    "style": {
                        "fontSize": 16,
                        "color": "red"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_header2": {
                    "type": "header",
                    "label": "tasmotaDeviceTools",
                    "text": "tasmotaDeviceTools",
                    "size": 3,
                    "newLine": true
                },
                "_selectIpForTools": {
                    "type": "autocompleteSendTo",
                    "command": "getTasmotaDevices",
                    "jsonData": "{\"ip\": \"${data.internalServerIp}\"}",
                    "label": "ipFromPanel",
                    "freeSolo": true,
                    "newLine": true,
                    "validator": "typeof data._selectIpForTools === 'string' && data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) !== -1",
                    "validatorErrorText": "mustBeIp",
                    "default": "",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_tasmotaRestartSendTo": {
                    "type": "sendTo",
                    "label": "Restart",
                    "jsonData": "{ \"tasmotaIP\": \"${data._selectIpForTools}\"}",
                    "showProcess": true,
                    "command": "tasmotaRestartSendTo",
                    "disabled": "!data._selectIpForTools || data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) === -1",
                    "variant": "outlined",
                    "confirm": {
                        "title": "Tasmota restart",
                        "text": "Restart the Tasmota NS panel.",
                        "ok": "Restart",
                        "cancel": "Cancel"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_openLinkToTasmota": {
                    "type": "sendTo",
                    "label": "openLinkToTasmota",
                    "jsonData": "{\"ip\": \"${data._selectIpForTools}\"}",
                    "openUrl": true,
                    "command": "openLinkToTasmota",
                    "disabled": "!data._selectIpForTools",
                    "variant": "outlined",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_berryInstallSendTo": {
                    "type": "sendTo",
                    "label": "berryInstallSendTo",
                    "jsonData": "{\"tasmotaIP\": \"${data._selectIpForTools}\"}",
                    "showProcess": true,
                    "command": "berryInstallSendTo",
                    "disabled": "!data._selectIpForTools || data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) === -1",
                    "variant": "contained",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_tftInstallSendTo": {
                    "type": "sendTo",
                    "label": "tftInstallSendTo",
                    "jsonData": "{\"tasmotaIP\": \"${data._selectIpForTools}\", \"internalServerIp\": \"${data.internalServerIp}\", \"useBetaTFT\": ${data.useBetaTFT}, \"model\": \"${data.nsPanelModel}\" }",
                    "showProcess": true,
                    "command": "tftInstallSendTo",
                    "disabled": "!data._selectIpForTools || data._selectIpForTools.search(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/g) === -1",
                    "variant": "contained",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_header": {
                    "type": "header",
                    "size": 5,
                    "text": "Expert Mode",
                    "expertMode": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_resetTasmota": {
                    "type": "sendTo",
                    "label": "resetTasmota",
                    "jsonData": "{\"tasmotaIP\": \"${data._selectIpForTools}\"}",
                    "openUrl": true,
                    "command": "resetTasmota",
                    "disabled": "!data._selectIpForTools",
                    "variant": "contained",
                    "expertMode": true,
                    "confirm": {
                        "title": "NSPanel Reset!!!",
                        "text": "Reset NSPanel configuration on the external device to factory defaults(Wifi not touched).",
                        "ok": "Reset",
                        "cancel": "Cancel"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_overview": {
            "type": "panel",
            "label": "nsPanelSettings",
            "hidden": "(!data.mqttServer && !data.mqttIp ) || !data.mqttPort || ((data.mqttServer || !data.mqttCredentialId) && (!data.mqttUsername || !data.mqttPassword))",
            "items": {
                "pagePanelOverview": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/PagePanelOverview",
                    "bundlerType": "module",
                    "xs": 12
                    //"label": "test"
                }
            }
        },
        "_general": {
            "type": "panel",
            "label": "mqttServerSetting",
            "items": {
                "pageMQTTSetting": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/PageMQTTSetting",
                    "bundlerType": "module",
                    "xs": 12
                    //"label": "test"
                }
            }
        },
        "_webPanel": {
            "type": "panel",
            "label": "webPanelSetting",
            "items": {
                "_webPanelHeader": {
                    "type": "staticText",
                    "text": "webPanelInfo",
                    "xs": 12
                },
                "webEnabled": {
                    "type": "checkbox",
                    "label": "webEnabled",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                },
                "webPort": {
                    "type": "port",
                    "label": "webPort",
                    "default": 8090,
                    "min": 1,
                    "max": 65535,
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webBind": {
                    "type": "text",
                    "label": "webBind",
                    "default": "0.0.0.0",
                    "disabled": "!data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webHost": {
                    "type": "text",
                    "label": "webHost",
                    "help": "webHostHelp",
                    "default": "",
                    "trim": true,
                    "disabled": "!data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webPin": {
                    "type": "password",
                    "label": "webPin",
                    "help": "webPinHelp",
                    "repeat": false,
                    "visible": true,
                    "default": "",
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webSecure": {
                    "type": "checkbox",
                    "label": "webSecure",
                    "help": "webSecureHelp",
                    "default": false,
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                },
                // the certificate select filters by the attribute name: *public*, *private*, *chained*
                "webCertPublic": {
                    "type": "certificate",
                    "label": "webCertPublic",
                    "default": "defaultPublic",
                    "disabled": "!data.webSecure || !data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webCertPrivate": {
                    "type": "certificate",
                    "label": "webCertPrivate",
                    "default": "defaultPrivate",
                    "disabled": "!data.webSecure || !data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webCertChained": {
                    "type": "certificate",
                    "label": "webCertChained",
                    "help": "webCertChainedHelp",
                    "default": "",
                    "disabled": "!data.webSecure || !data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webFido": {
                    "type": "checkbox",
                    "label": "webFido",
                    "help": "webFidoHelp",
                    "default": false,
                    "disabled": "!data.webEnabled || !data.webSecure",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                },
                "_webFidoRequirements": {
                    "type": "staticText",
                    "text": "webFidoRequirements",
                    "hidden": "!data.webFido",
                    "newLine": true,
                    "xs": 12
                },
                "_webFidoKeys": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/WebFidoKeys",
                    "bundlerType": "module",
                    "hidden": "!data.webFido",
                    "newLine": true,
                    "xs": 12
                }
            }
        },
        "developer": {
            "type": "panel",
            "label": "developer",
            "expertMode": true,
            "items": {
                "additionalLog": {
                    "type": "checkbox",
