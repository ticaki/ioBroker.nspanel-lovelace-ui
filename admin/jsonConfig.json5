        "_webPanel": {
            "type": "panel",
            "label": "webPanelSetting",
            "items": {
                "_webPanelHeader": {
                    "type": "staticText",
                    "text": "webPanelInfo",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                // documentation of the web panels in the ioBroker system language (German -> de, else en)
                "_webPanelDoc": {
                    "type": "staticLink",
                    "text": "documentation",
                    "href": "https://ticaki.github.io/ioBroker.nspanel-lovelace-ui/${_system.language === 'de' ? 'de' : 'en'}/WebPanel.html",
                    "icon": "info",
                    "button": true,
                    "variant": "text",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webEnabled": {
                    "type": "checkbox",
                    "label": "webEnabled",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                },
                "webPort": {
                    "type": "port",
                    "label": "webPort",
                    "default": 8090,
                    "min": 1,
                    "max": 65535,
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webBind": {
                    "type": "text",
                    "label": "webBind",
                    "default": "0.0.0.0",
                    "disabled": "!data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webHost": {
                    "type": "text",
                    "label": "webHost",
                    "help": "webHostHelp",
                    "default": "",
                    "trim": true,
                    "disabled": "!data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webPin": {
                    "type": "password",
                    "label": "webPin",
                    "help": "webPinHelp",
                    "repeat": false,
                    "visible": true,
                    "default": "",
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webSecure": {
                    "type": "checkbox",
                    "label": "webSecure",
                    "help": "webSecureHelp",
                    "default": false,
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                },
                // the certificate select filters by the attribute name: *public*, *private*, *chained*
                "webCertPublic": {
                    "type": "certificate",
                    "label": "webCertPublic",
                    "default": "defaultPublic",
                    "disabled": "!data.webSecure || !data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webCertPrivate": {
                    "type": "certificate",
                    "label": "webCertPrivate",
                    "default": "defaultPrivate",
                    "disabled": "!data.webSecure || !data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webCertChained": {
                    "type": "certificate",
                    "label": "webCertChained",
                    "help": "webCertChainedHelp",
                    "default": "",
                    "disabled": "!data.webSecure || !data.webEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 2
                },
                "webFido": {
                    "type": "checkbox",
                    "label": "webFido",
                    "help": "webFidoHelp",
                    "default": false,
                    "disabled": "!data.webEnabled || !data.webSecure",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                },
                "_webFidoRequirements": {
                    "type": "staticText",
                    "text": "webFidoRequirements",
                    "hidden": "!data.webFido",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_webFidoKeys": {
                    "type": "custom",
                    "guiApi": 2,
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "AdminComponentTemplateSet/Components/WebFidoKeys",
                    "bundlerType": "module",
                    "hidden": "!data.webFido",
                    "newLine": true,
                    "xs": 12
                },
                // collective switch: the web panels may do more than the hardware panel (today: all icons in popupNotify3)
                "webAllowExtensions": {
                    "type": "checkbox",
                    "label": "webAllowExtensions",
                    "help": "webAllowExtensionsHelp",
                    "default": false,
                    "disabled": "!data.webEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 3
                }
            }
        },
