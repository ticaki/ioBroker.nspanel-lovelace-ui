{
    "name": "iobroker-admin-component-easy-access",
    "private": true,
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "start": "vite --port 4173",
        "lint": "eslint -c eslint.config.mjs",
        "build": "npm run sync:datapoints && tsc && vite build && npm run copy:custom",
        "copy:custom": "tsx ../tasks.ts admin:copy",
        "sync:datapoints": "tsx ../tasks.ts sync:datapoints"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/build-tools": "^3.0.1",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/gui-components": "^10.1.0",
        "@iobroker/json-config": "^9.0.20",
        "@module-federation/runtime": "^2.8.2",
        "@module-federation/vite": "^1.20.7",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "@originjs/vite-plugin-federation": "^1.4.1",
        "@types/d3-hierarchy": "^3.1.7",
        "@types/lodash": "^4.17.24",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@xyflow/react": "^12.11.3",
        "baseline-browser-mapping": "^2.10.43",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.1",
        "vite-plugin-commonjs": "^0.10.4"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "d3-hierarchy": "^3.1.2",
        "lodash": "^4.17.23"
    }
}
